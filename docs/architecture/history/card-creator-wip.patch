+
+button.type-chip {
+  border-radius: 12px;
+  padding: 2px 10px;
+}
+
+button.type-chip.active {
+  border-color: var(--accent);
+  background: var(--accent);
+  color: var(--bg);
+  font-weight: 600;
+}
+
+button.type-chip.active .chip-count {
+  color: inherit;
+}
+
+button.type-chip.unimplemented {
+  opacity: 0.55;
+}
+
+.chip-count {
+  color: var(--muted);
+}
+
+#status-line.error {
+  color: var(--p2);
+}
+
+.muted { color: var(--muted); }
+.small-text { font-size: 12px; }
+.hidden { display: none; }
+
+.group-title {
+  font-size: 13px;
+  text-transform: uppercase;
+  letter-spacing: 0.06em;
+  color: var(--muted);
+  margin: 16px 0 6px;
+}
+
+.type-header {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 8px 0 4px;
+  border-top: 1px solid var(--cell-stroke);
+}
+
+.type-name { font-weight: 600; }
+.type-header button { margin-left: auto; }
+
+.card-rows {
+  list-style: none;
+  margin: 0 0 6px;
+  padding: 0;
+}
+
+.card-row {
+  padding: 5px 8px;
+  border-radius: 4px;
+  cursor: pointer;
+}
+
+.card-row:hover { background: var(--cell-fill); }
+.card-row.selected { outline: 1px solid var(--accent); }
+.has-comment { color: var(--accent); }
+
+.editor-toolbar {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  flex-wrap: wrap;
+  margin-bottom: 12px;
+}
+
+.editor-toolbar h2 {
+  margin: 0 auto 0 0;
+  font-size: 16px;
+}
+
+.dirty-flag {
+  color: var(--accent);
+  font-size: 12px;
+}
+
+button.primary { border-color: var(--accent); }
+button.danger { border-color: var(--p2); }
+
+.card-form {
+  display: grid;
+  gap: 10px;
+}
+
+.form-row {
+  display: grid;
+  grid-template-columns: 140px 1fr;
+  gap: 12px;
+  align-items: start;
+}
+
+.form-label {
+  padding-top: 4px;
+  color: var(--muted);
+  font-size: 13px;
+}
+
+.checkboxes {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 4px 16px;
+}
+
+.card-form textarea,
+.card-form input[type="text"] {
+  width: 100%;
+}
+
+textarea.json {
+  width: 100%;
+  font-family: ui-monospace, Consolas, monospace;
+  font-size: 12px;
+}
+
+textarea.raw { min-height: 420px; }
+
+.field-warning {
+  margin: 4px 0 0;
+  color: var(--p2);
+  font-size: 12px;
+}
+
+.not-implemented {
+  color: var(--accent);
+  font-style: italic;
+}
