+using Leyline.Content.Json;
+using Leyline.RulesCore.State;
+
+namespace Leyline.Scenarios.Tests;
+
+/// <summary>Guards the repo's card catalog (content/cards, edited by hand and by the DebugUi card
+/// editor): it must always load in the engine, and every card the DebugUi scenarios define
+/// inline must agree with the catalog's version of it.</summary>
+public class CardCatalogContentTests
+{
+    private static string RepoRoot()
+    {
+        var dir = new DirectoryInfo(AppContext.BaseDirectory);
+        while (dir is not null && !File.Exists(Path.Combine(dir.FullName, "Leyline.slnx")))
+            dir = dir.Parent;
+        return dir?.FullName ?? throw new DirectoryNotFoundException("Repo root (Leyline.slnx) not found.");
+    }
+
+    [Fact]
+    public void Scenario_cards_match_the_catalog()
+    {
+        var root = RepoRoot();
+        var catalog = JsonCardDefinitionRepository.LoadFromDirectory(Path.Combine(root, "content", "cards"));
+
+        var scenarioFiles = Directory.GetFiles(Path.Combine(root, "tools", "Leyline.DebugUi", "scenarios"), "*.scenario");
+        Assert.NotEmpty(scenarioFiles);
+
+        foreach (var file in scenarioFiles)
+        {
+            var content = ScenarioLoader.LoadFromFile(file).State.Content;
+            var ids = File.ReadLines(file)
+                .Where(line => line.StartsWith("card "))
+                .Select(line => new CardDefinitionId(line.Split(' ')[1]));
+
+            foreach (var id in ids)
+            {
+                var expected = content.Get(id);
+                var actual = catalog.Get(id);
+                Assert.Equal(expected with { AbilityIds = [] }, actual with { AbilityIds = [] });
+                Assert.Equal(expected.AbilityIds, actual.AbilityIds);
+            }
+        }
+    }
+}
