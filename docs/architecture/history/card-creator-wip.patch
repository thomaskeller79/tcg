diff --git a/tools/Leyline.DebugUi/wwwroot/cards.js b/tools/Leyline.DebugUi/wwwroot/cards.js
new file mode 100644
index 0000000..71d6af4
--- /dev/null
+++ b/tools/Leyline.DebugUi/wwwroot/cards.js
@@ -0,0 +1,523 @@
+// Card creator: browse, edit, copy and delete the card catalog (content/cards/<id>.json, one
+// file per card — see Leyline.Content.Json.CardCatalog). Cards are edited as raw JSON objects:
+// properties this editor doesn't know are shown under "Other properties" and written back
+// untouched, so a card file never loses data just because the editor lags behind the schema.
+//
+// FIELDS and TYPES below are the editor's whole schema — the one place to change when Track A
+// adds, renames or retypes a card property. Paths with a dot ("stats.attack") are nested objects.
+
+const ABILITIES = {
+  creature: ['core.move', 'core.attack'],
+  champion: ['core.move', 'core.attack', 'champion.bond', 'champion.draw', 'champion.collapse'],
+};
+
+const FIELDS = {
+  'name':         { label: 'Name', kind: 'text' },
+  'manaCost':     { label: 'Mana cost', kind: 'int' },
+  'stats.attack': { label: 'Attack', kind: 'int' },
+  'stats.life':   { label: 'Life', kind: 'int' },
+  'stats.ap':     { label: 'AP', kind: 'int' },
+  'abilities':    { label: 'Abilities', kind: 'multi' },
+  'effectId':     { label: 'Effect', kind: 'select', options: ['spell.damage', 'spell.heal'] },
+  'effectAmount': { label: 'Effect amount', kind: 'int' },
+};
+
+// `fields: null` = the engine can't load this type yet; the editor only shows "not implemented yet".
+const TYPES = [
+  { type: 'Creature',  group: 'Deck cards', fields: ['name', 'manaCost', 'stats.attack', 'stats.life', 'stats.ap', 'abilities'], abilities: ABILITIES.creature },
+  { type: 'Companion', group: 'Deck cards', fields: null },
+  { type: 'Structure', group: 'Deck cards', fields: null },
+  { type: 'Item',      group: 'Deck cards', fields: null },
+  { type: 'Spell',     group: 'Deck cards', fields: ['name', 'manaCost', 'effectId', 'effectAmount'] },
+  { type: 'Champion',  group: 'Special',    fields: ['name', 'stats.attack', 'stats.life', 'stats.ap', 'abilities'], abilities: ABILITIES.champion },
+  { type: 'Map',       group: 'Special',    fields: null },
+  { type: 'Terrain',   group: 'Special',    fields: null },
+];
+
+const typeInfo = type => TYPES.find(t => t.type === type);
+const OTHER_TYPE = '__other';
+const implementedTypes = TYPES.filter(t => t.fields);
+
+// ---- JSON path helpers -------------------------------------------------------------------
+
+const clone = v => JSON.parse(JSON.stringify(v));
+
+function getPath(obj, path) {
+  return path.split('.').reduce((o, k) => (o && typeof o === 'object' ? o[k] : undefined), obj);
+}
+
+function setPath(obj, path, value) {
+  const keys = path.split('.');
+  let o = obj;
+  for (const k of keys.slice(0, -1)) {
+    if (!o[k] || typeof o[k] !== 'object' || Array.isArray(o[k])) o[k] = {};
+    o = o[k];
+  }
+  o[keys.at(-1)] = value;
+}
+
+/// Removes a path, and any parent object it leaves empty.
+function deletePath(obj, path) {
+  const keys = path.split('.');
+  const parents = [obj];
+  for (const k of keys.slice(0, -1)) {
+    const next = parents.at(-1)?.[k];
+    if (!next || typeof next !== 'object') return;
+    parents.push(next);
+  }
+  delete parents.at(-1)[keys.at(-1)];
+  for (let i = parents.length - 1; i > 0; i--) {
+    if (Object.keys(parents[i]).length === 0) delete parents[i - 1][keys[i - 1]];
+  }
+}
+
+/// Deep-merges `extra` into `target` without overwriting anything `target` already has.
+function mergeMissing(target, extra) {
+  for (const [k, v] of Object.entries(extra)) {
+    if (!(k in target)) target[k] = v;
+    else if (v && typeof v === 'object' && !Array.isArray(v) && typeof target[k] === 'object') mergeMissing(target[k], v);
+  }
+}
+
+// ---- State -------------------------------------------------------------------------------
+
+const state = {
+  cards: [],
+  previousId: null,   // id the open card was loaded under; null = new card / copy
+  draft: null,        // the open card as a JSON object; null = nothing open
+  notice: null,       // type name when showing "not implemented yet"
+  listType: 'Creature', // type picked in the left pane (or OTHER_TYPE)
+  mode: 'form',       // 'form' | 'raw'
+  dirty: false,
+  filter: '',
+};
+
+async function api(path, options) {
+  const res = await fetch(path, options);
+  const text = await res.text();
+  if (!res.ok) {
+    let message = text;
+    try { message = JSON.parse(text); } catch { /* plain-text body */ }
+    throw new Error(message || `${res.status} ${res.statusText}`);
+  }
+  return text ? JSON.parse(text) : null;
+}
+
+function setStatus(text, isError = false) {
+  const el = document.getElementById('status-line');
+  el.textContent = text;
+  el.classList.toggle('error', isError);
+}
+
+async function reloadCards() {
+  state.cards = await api('/api/catalog/cards');
+  renderList();
+}
+
+function confirmDiscard() {
+  return !state.dirty || window.confirm('Discard unsaved changes to the open card?');
+}
+
+function openCard(card, previousId) {
+  state.draft = clone(card);
+  state.previousId = previousId;
+  state.listType = typeInfo(card.type) ? card.type : OTHER_TYPE;
+  state.notice = null;
+  state.dirty = false;
+  renderList();
+  renderEditor();
+}
+
+function newCard(type) {
+  if (!confirmDiscard()) return;
+  const info = typeInfo(type);
+  if (!info.fields) {
+    state.draft = null;
+    state.notice = type;
+    state.dirty = false;
+    renderList();
+    renderEditor();
+    return;
+  }
+  const card = { id: '', type };
+  for (const path of info.fields) {
+    const field = FIELDS[path];
+    setPath(card, path, field.kind === 'int' ? 0 : field.kind === 'multi' ? [] : field.kind === 'select' ? field.options[0] : '');
+  }
+  card.comment = '';
+  openCard(card, null);
+}
+
+// ---- List --------------------------------------------------------------------------------
+
+function summarize(card) {
+  const parts = [];
+  if (card.manaCost !== undefined) parts.push(`${card.manaCost} mana`);
+  if (card.stats) parts.push(`${card.stats.attack ?? '?'}/${card.stats.life ?? '?'}/${card.stats.ap ?? '?'}`);
+  if (card.effectId) parts.push(`${card.effectId.replace(/^spell\./, '')} ${card.effectAmount ?? ''}`.trim());
+  return parts.join(' · ');
+}
+
+function matchesFilter(card) {
+  const f = state.filter.trim().toLowerCase();
+  if (!f) return true;
+  return [card.id, card.name, card.comment].some(v => typeof v === 'string' && v.toLowerCase().includes(f));
+}
+
+/// Cards of the picked list type; OTHER_TYPE collects cards whose type isn't in TYPES at all
+/// (e.g. a hand-edited file), so they stay reachable.
+function cardsOfListType() {
+  if (state.listType !== OTHER_TYPE) return state.cards.filter(c => c.type === state.listType);
+  const known = new Set(TYPES.map(t => t.type));
+  return state.cards.filter(c => !known.has(c.type));
+}
+
+function renderTypePicker() {
+  const picker = document.getElementById('type-picker');
+  picker.replaceChildren();
+
+  const count = type => state.cards.filter(c => c.type === type).length;
+  const groups = [...new Set(TYPES.map(t => t.group))].map(group => [group, TYPES.filter(t => t.group === group).map(t => t.type)]);
+  const known = new Set(TYPES.map(t => t.type));
+  const otherCount = state.cards.filter(c => !known.has(c.type)).length;
+  if (otherCount) groups.push(['Unknown type', [OTHER_TYPE]]);
+
+  for (const [group, types] of groups) {
+    const chips = el('div', { class: 'type-chips' });
+    for (const type of types) {
+      const n = type === OTHER_TYPE ? otherCount : count(type);
+      const chip = button('', () => {
+        state.listType = type;
+        renderList();
+      }, false, 'type-chip' + (state.listType === type ? ' active' : '') + (typeInfo(type)?.fields || type === OTHER_TYPE ? '' : ' unimplemented'));
+      chip.append(type === OTHER_TYPE ? 'Other' : type, el('span', { class: 'chip-count' }, n ? ` ${n}` : ''));
+      chips.append(chip);
+    }
+    picker.append(el('div', { class: 'type-group' }, el('h2', { class: 'group-title' }, group), chips));
+  }
+}
+
+function renderList() {
+  renderTypePicker();
+
+  const list = document.getElementById('card-list');
+  list.replaceChildren();
+
+  const type = state.listType;
+  const header = el('div', { class: 'type-header' }, el('span', { class: 'type-name' }, type === OTHER_TYPE ? 'Unknown type' : type));
+  if (type !== OTHER_TYPE) header.append(button(`+ New ${type}`, () => newCard(type), false, 'small'));
+  list.append(header);
+
+  if (type !== OTHER_TYPE && !typeInfo(type).fields) {
+    list.append(el('p', { class: 'not-implemented' }, 'Not implemented yet.'));
+  }
+
+  const cards = cardsOfListType();
+  const shown = cards.filter(matchesFilter).sort((a, b) => String(a.name).localeCompare(String(b.name)));
+  if (cards.length && !shown.length) list.append(el('p', { class: 'muted small-text' }, 'No card matches the filter.'));
+  else if (!cards.length && typeInfo(type)?.fields) list.append(el('p', { class: 'muted small-text' }, 'No cards yet.'));
+
+  const ul = el('ul', { class: 'card-rows' });
+  for (const card of shown) {
+    const li = el('li', { class: 'card-row' + (state.previousId === card.id && state.draft ? ' selected' : '') },
+      el('div', { class: 'card-row-title' }, card.name || '(no name)', card.comment ? el('span', { class: 'has-comment', title: card.comment }, ' ✎') : ''),
+      el('div', { class: 'muted small-text' }, `${card.id} · ${summarize(card)}`));
+    li.onclick = () => {
+      if (state.previousId === card.id && state.draft) return;
+      if (confirmDiscard()) openCard(card, card.id);
+    };
+    ul.append(li);
+  }
+  list.append(ul);
+}
+
+// ---- Editor ------------------------------------------------------------------------------
+
+/// Splits a card into what the form shows (id/type/schema fields/comment) and everything else.
+function otherProperties(card) {
+  const rest = clone(card);
+  delete rest.id;
+  delete rest.type;
+  delete rest.comment;
+  for (const path of typeInfo(card.type)?.fields ?? []) deletePath(rest, path);
+  return rest;
+}
+
+/// Reads the form back into a card object, in a canonical key order (id, type, schema fields,
+/// comment, other properties) so saved files diff cleanly.
+function readForm() {
+  const form = document.getElementById('card-form');
+  const card = { id: form.elements.id.value.trim(), type: form.elements.type.value };
+
+  // The inputs on screen belong to the type the form was rendered for — after a type switch
+  // that's the old type, and its fields must be read (then land in "Other properties").
+  for (const path of typeInfo(state.draft.type)?.fields ?? []) {
+    const field = FIELDS[path];
+    if (field.kind === 'multi') {
+      setPath(card, path, [...form.querySelectorAll(`input[data-path="${path}"]:checked`)].map(i => i.value));
+      continue;
+    }
+    const input = form.querySelector(`[data-path="${path}"]`);
+    if (!input) continue;
+    if (field.kind === 'int') {
+      if (input.value.trim() !== '') setPath(card, path, Number(input.value));
+    } else if (field.kind === 'select') {
+      if (input.value !== '') setPath(card, path, input.value);
+    } else {
+      setPath(card, path, input.value);
+    }
+  }
+  card.comment = form.elements.comment.value;
+
+  const otherText = form.elements.other.value.trim();
+  let other = {};
+  if (otherText) {
+    other = JSON.parse(otherText);
+    if (!other || typeof other !== 'object' || Array.isArray(other)) throw new Error('Other properties must be a JSON object.');
+  }
+  mergeMissing(card, other);
+  return card;
+}
+
+/// The open card as currently edited, whichever mode the editor is in.
+function currentDraft() {
+  if (state.mode === 'raw') {
+    const parsed = JSON.parse(document.getElementById('raw-json').value);
+    if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) throw new Error('The card must be a JSON object.');
+    return parsed;
+  }
+  return readForm();
+}
+
+function renderEditor() {
+  const pane = document.getElementById('card-editor');
+  pane.replaceChildren();
+
+  if (state.notice) {
+    pane.append(el('h2', {}, `New ${state.notice}`), el('p', { class: 'not-implemented' }, 'Not implemented yet.'));
+    return;
+  }
+  if (!state.draft) {
+    pane.append(el('p', { class: 'muted' }, 'Pick a card on the left, or create a new one with a type’s “+ New”.'));
+    return;
+  }
+
+  const card = state.draft;
+  const title = state.previousId ? `Edit ${card.name || card.id}` : `New ${card.type}`;
+  const toolbar = el('div', { class: 'editor-toolbar' },
+    el('h2', {}, title),
+    el('span', { class: 'dirty-flag' + (state.dirty ? '' : ' hidden') }, 'unsaved'),
+    button(state.mode === 'form' ? 'Raw JSON' : 'Form', toggleMode),
+    button('Copy', copyCard, !state.previousId),
+    button('Revert', revert),
+    deleteButton(),
+    button('Save', save, false, 'primary'));
+  pane.append(toolbar);
+
+  if (state.mode === 'raw') {
+    const area = el('textarea', { id: 'raw-json', class: 'json raw', spellcheck: 'false' });
+    area.value = JSON.stringify(card, null, 2);
+    area.oninput = markDirty;
+    pane.append(el('p', { class: 'muted small-text' }, 'The whole card file. Saved exactly as written (after the engine-compatibility check).'), area);
+    return;
+  }
+
+  const form = el('form', { id: 'card-form', class: 'card-form' });
+  form.onsubmit = e => e.preventDefault();
+  form.oninput = markDirty;
+
+  // Early warning only — CardCatalog.Save is the real uniqueness check (same rule: ignoring case).
+  const idInput = input('id', 'text', card.id ?? '', { name: 'id', placeholder: 'e.g. creature.grunt' });
+  const idWarning = el('p', { class: 'field-warning hidden' });
+  idInput.addEventListener('input', () => {
+    const id = idInput.value.trim().toLowerCase();
+    const taken = state.cards.find(c => typeof c.id === 'string' && c.id.toLowerCase() === id && c.id !== state.previousId);
+    idWarning.textContent = taken ? `Id already used by “${taken.name ?? taken.id}” (${taken.type}).` : '';
+    idWarning.classList.toggle('hidden', !taken);
+  });
+  form.append(row('Id', el('div', {}, idInput, idWarning)));
+
+  const typeSelect = el('select', { name: 'type' });
+  const types = typeInfo(card.type)?.fields ? implementedTypes : [{ type: card.type }, ...implementedTypes];
+  for (const t of types) typeSelect.append(el('option', { value: t.type }, t.type));
+  typeSelect.value = card.type;
+  typeSelect.onchange = () => {
+    // Keep what was typed: fields the new type doesn't have move to "Other properties".
+    try {
+      state.draft = readForm();
+      markDirty();
+      renderEditor();
+    } catch (e) {
+      typeSelect.value = card.type;
+      setStatus(e.message, true);
+    }
+  };
+  form.append(row('Type', typeSelect));
+
+  const info = typeInfo(card.type);
+  if (!info?.fields) {
+    form.append(el('p', { class: 'not-implemented' }, `${card.type}: not implemented yet — edit it as raw JSON.`));
+  }
+
+  for (const path of info?.fields ?? []) {
+    const field = FIELDS[path];
+    const value = getPath(card, path);
+    if (field.kind === 'multi') {
+      const boxes = el('div', { class: 'checkboxes' });
+      const selected = Array.isArray(value) ? value : [];
+      // Selected values unknown to the schema are still listed, so saving never drops them.
+      for (const option of [...new Set([...(info.abilities ?? []), ...selected])]) {
+        const box = el('input', { type: 'checkbox', value: option, 'data-path': path });
+        box.checked = selected.includes(option);
+        boxes.append(el('label', {}, box, ` ${option}`));
+      }
+      form.append(row(field.label, boxes));
+    } else if (field.kind === 'select') {
+      // A blank option stands for "property absent" — never invent a value the card didn't have.
+      const select = el('select', { 'data-path': path });
+      for (const option of ['', ...new Set([...field.options, ...(value ? [value] : [])])]) select.append(el('option', { value: option }, option || '—'));
+      select.value = value ?? '';
+      form.append(row(field.label, select));
+    } else {
+      form.append(row(field.label, input(path, field.kind === 'int' ? 'number' : 'text', value ?? '', { 'data-path': path })));
+    }
+  }
+
+  const comment = el('textarea', { name: 'comment', rows: '4', placeholder: 'Design notes — stored in the card file, never shown in the game.' });
+  comment.value = card.comment ?? '';
+  form.append(row('Comment', comment));
+
+  const other = otherProperties(card);
+  const otherArea = el('textarea', { name: 'other', class: 'json', rows: '6', spellcheck: 'false' });
+  otherArea.value = Object.keys(other).length ? JSON.stringify(other, null, 2) : '';
+  form.append(row('Other properties', el('div', {},
+    otherArea,
+    el('p', { class: 'muted small-text' }, 'Properties this editor has no field for yet (JSON object). Kept as-is on save; delete them here to remove them.'))));
+
+  pane.append(form);
+}
+
+function markDirty() {
+  state.dirty = true;
+  document.querySelector('.dirty-flag')?.classList.remove('hidden');
+}
+
+function toggleMode() {
+  try {
+    state.draft = currentDraft();
+  } catch (e) {
+    setStatus(`Can't switch: ${e.message}`, true);
+    return;
+  }
+  state.mode = state.mode === 'form' ? 'raw' : 'form';
+  renderEditor();
+}
+
+function copyCard() {
+  let card;
+  try {
+    card = currentDraft();
+  } catch (e) {
+    setStatus(e.message, true);
+    return;
+  }
+  card.id = `${card.id}.copy`;
+  if (card.name) card.name = `${card.name} (copy)`;
+  openCard(card, null);
+  state.dirty = true;
+  renderEditor();
+  setStatus('Copy created — change its id and save.');
+}
+
+function revert() {
+  const original = state.previousId && state.cards.find(c => c.id === state.previousId);
+  state.dirty = false;
+  if (original) openCard(original, original.id);
+  else newCard(state.draft.type);
+  setStatus('');
+}
+
+function deleteButton() {
+  const b = button('Delete', null, !state.previousId, 'danger');
+  b.onclick = async () => {
+    if (b.dataset.armed !== 'yes') {
+      b.dataset.armed = 'yes';
+      b.textContent = 'Confirm delete';
+      return;
+    }
+    try {
+      await api(`/api/catalog/cards/${encodeURIComponent(state.previousId)}`, { method: 'DELETE' });
+      setStatus(`Deleted ${state.previousId}.`);
+      state.draft = null;
+      state.previousId = null;
+      state.dirty = false;
+      await reloadCards();
+      renderEditor();
+    } catch (e) {
+      setStatus(e.message, true);
+    }
+  };
+  return b;
+}
+
+async function save() {
+  let card;
+  try {
+    card = currentDraft();
+  } catch (e) {
+    setStatus(`Invalid JSON: ${e.message}`, true);
+    return;
+  }
+  try {
+    await api('/api/catalog/cards', {
+      method: 'PUT',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ card, previousId: state.previousId }),
+    });
+    await reloadCards();
+    openCard(card, card.id);
+    setStatus(`Saved ${card.id}.`);
+  } catch (e) {
+    state.draft = card;
+    setStatus(e.message, true);
+  }
+}
+
+// ---- DOM helpers -------------------------------------------------------------------------
+
+function el(tag, attrs = {}, ...children) {
+  const node = document.createElement(tag);
+  for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, v);
+  node.append(...children.filter(c => c !== null && c !== undefined));
+  return node;
+}
+
+function button(label, onclick, disabled = false, cls = '') {
+  const b = el('button', { type: 'button', class: cls });
+  b.textContent = label;
+  b.disabled = disabled;
+  if (onclick) b.onclick = onclick;
+  return b;
+}
+
+function input(name, type, value, attrs) {
+  const i = el('input', { type, ...attrs });
+  i.value = value;
+  return i;
+}
+
+function row(label, control) {
+  return el('div', { class: 'form-row' }, el('label', { class: 'form-label' }, label), control);
+}
+
+// ---- Boot --------------------------------------------------------------------------------
+
+document.getElementById('card-filter').oninput = e => {
+  state.filter = e.target.value;
+  renderList();
+};
+window.addEventListener('beforeunload', e => {
+  if (state.dirty) e.preventDefault();
+});
+
+reloadCards().catch(e => setStatus(e.message, true));
