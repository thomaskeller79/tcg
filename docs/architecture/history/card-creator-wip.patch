+using System.Text.Json.Nodes;
+using Leyline.Content.Json;
+using Leyline.RulesCore.State;
+
+namespace Leyline.RulesCore.Tests.TestSupport;
+
+public sealed class CardCatalogTests : IDisposable
+{
+    private readonly string _dir = Directory.CreateTempSubdirectory("leyline-catalog-").FullName;
+    private readonly CardCatalog _catalog;
+
+    public CardCatalogTests()
+    {
+        _catalog = new CardCatalog(_dir);
+    }
+
+    public void Dispose() => Directory.Delete(_dir, recursive: true);
+
+    private static JsonObject Grunt(string id = "test.grunt") => new()
+    {
+        ["id"] = id,
+        ["type"] = "Creature",
+        ["name"] = "Grunt",
+        ["manaCost"] = 2,
+        ["stats"] = new JsonObject { ["attack"] = 3, ["life"] = 5, ["ap"] = 3 },
+        ["abilities"] = new JsonArray("core.move", "core.attack"),
+        ["comment"] = "a note",
+    };
+
+    [Fact]
+    public void Saved_card_loads_in_the_engine_and_keeps_properties_the_engine_ignores()
+    {
+        var card = Grunt();
+        card["someFutureProperty"] = new JsonObject { ["x"] = 1 };
+
+        _catalog.Save(card, previousId: null);
+
+        var def = JsonCardDefinitionRepository.LoadFromDirectory(_dir).Get(new CardDefinitionId("test.grunt"));
+        Assert.Equal(("Grunt", 3, 5, 3, 2), (def.Name, def.Attack, def.Life, def.MaxAp, def.ManaCost));
+
+        var listed = Assert.Single(_catalog.List());
+        Assert.Equal("a note", (string?)listed["comment"]);
+        Assert.Equal(1, (int?)listed["someFutureProperty"]?["x"]);
+    }
+
+    [Fact]
+    public void New_card_may_not_overwrite_an_existing_one()
+    {
+        _catalog.Save(Grunt(), previousId: null);
+
+        var ex = Assert.Throws<InvalidDataException>(() => _catalog.Save(Grunt(), previousId: null));
+        Assert.Contains("already exists", ex.Message);
+    }
+
+    [Fact]
+    public void Ids_are_unique_ignoring_case()
+    {
+        _catalog.Save(Grunt(), previousId: null);
+
+        var ex = Assert.Throws<InvalidDataException>(() => _catalog.Save(Grunt("Test.Grunt"), previousId: null));
+        Assert.Contains("already exists", ex.Message);
+    }
+
+    [Fact]
+    public void Uniqueness_uses_the_id_inside_the_file_not_the_file_name()
+    {
+        File.WriteAllText(Path.Combine(_dir, "hand-edited.json"), Grunt().ToJsonString());
+
+        Assert.Throws<InvalidDataException>(() => _catalog.Save(Grunt(), previousId: null));
+    }
+
+    [Fact]
+    public void Renaming_an_id_to_one_already_taken_is_refused()
+    {
+        _catalog.Save(Grunt(), previousId: null);
+        _catalog.Save(Grunt("test.other"), previousId: null);
+
+        Assert.Throws<InvalidDataException>(() => _catalog.Save(Grunt("test.grunt"), previousId: "test.other"));
+        Assert.Equal(2, _catalog.List().Count);
+    }
+
+    [Fact]
+    public void Case_only_rename_keeps_the_card()
+    {
+        _catalog.Save(Grunt(), previousId: null);
+
+        _catalog.Save(Grunt("Test.Grunt"), previousId: "test.grunt");
+
+        Assert.Equal(["Test.Grunt"], _catalog.List().Select(c => (string?)c["id"]));
+    }
+
+    [Fact]
+    public void Renaming_a_hand_edited_file_replaces_it_instead_of_duplicating()
+    {
+        File.WriteAllText(Path.Combine(_dir, "hand-edited.json"), Grunt().ToJsonString());
+
+        _catalog.Save(Grunt("test.renamed"), previousId: "test.grunt");
+
+        Assert.Equal(["test.renamed"], _catalog.List().Select(c => (string?)c["id"]));
+    }
+
+    [Fact]
+    public void Saving_an_edit_of_a_card_that_no_longer_exists_is_refused()
+    {
+        Assert.Throws<InvalidDataException>(() => _catalog.Save(Grunt(), previousId: "test.gone"));
+        Assert.Empty(_catalog.List());
+    }
+
+    [Fact]
+    public void Engine_loader_rejects_duplicate_ids()
+    {
+        File.WriteAllText(Path.Combine(_dir, "a.json"), Grunt().ToJsonString());
+        File.WriteAllText(Path.Combine(_dir, "b.json"), Grunt("TEST.GRUNT").ToJsonString());
+
+        var ex = Assert.Throws<InvalidDataException>(() => JsonCardDefinitionRepository.LoadFromDirectory(_dir));
+        Assert.Contains("Duplicate card id", ex.Message);
+    }
+
+    [Fact]
+    public void Changing_the_id_moves_the_file()
+    {
+        _catalog.Save(Grunt(), previousId: null);
+
+        _catalog.Save(Grunt("test.big_grunt"), previousId: "test.grunt");
+
+        Assert.Equal(["test.big_grunt"], _catalog.List().Select(c => (string?)c["id"]));
+    }
+
+    [Fact]
+    public void Delete_removes_the_card()
+    {
+        _catalog.Save(Grunt(), previousId: null);
+
+        _catalog.Delete("test.grunt");
+
+        Assert.Empty(_catalog.List());
+    }
+
+    [Theory]
+    [InlineData("../escape")]
+    [InlineData("has space")]
+    [InlineData(".hidden")]
+    [InlineData("")]
+    public void Rejects_ids_that_are_not_safe_file_names(string id)
+    {
+        Assert.Throws<InvalidDataException>(() => _catalog.Save(Grunt(id), previousId: null));
+    }
+
+    [Theory]
+    [InlineData("Companion")]
+    [InlineData("Structure")]
+    [InlineData("Item")]
+    [InlineData("Map")]
+    [InlineData("Terrain")]
+    public void Rejects_card_types_the_engine_does_not_implement_yet(string type)
+    {
+        var card = Grunt();
+        card["type"] = type;
+
+        var ex = Assert.Throws<InvalidDataException>(() => _catalog.Save(card, previousId: null));
+        Assert.Contains("not implemented yet", ex.Message);
+    }
+
+    [Fact]
+    public void Rejects_a_card_the_engine_cannot_parse()
+    {
+        var card = Grunt();
+        card["manaCost"] = "two";
+
+        Assert.Throws<InvalidDataException>(() => _catalog.Save(card, previousId: null));
+        Assert.Empty(_catalog.List());
+    }
+}
