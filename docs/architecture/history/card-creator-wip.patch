new file mode 100644
index 0000000..601e27c
--- /dev/null
+++ b/src/Leyline.Content.Json/CardCatalog.cs
@@ -0,0 +1,102 @@
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using System.Text.RegularExpressions;
+using Leyline.RulesCore.State;
+
+namespace Leyline.Content.Json;
+
+/// <summary>
+/// Read/write access to a directory of card files (one `&lt;id&gt;.json` per card) for authoring
+/// tools like the DebugUi card editor. Cards are handled as raw JSON objects, not as
+/// CardDefinition, so a property the engine doesn't know yet (the editor-only "comment", or a
+/// field Track A adds before the engine reads it) survives a load/edit/save round trip
+/// untouched. Every save is still checked by parsing it the way the engine does, so the
+/// directory stays loadable by JsonCardDefinitionRepository.LoadFromDirectory.
+/// </summary>
+public sealed partial class CardCatalog(string directory)
+{
+    private static readonly JsonSerializerOptions WriteOptions = new() { WriteIndented = true };
+
+    /// <summary>Types the engine can load today (CardType). Other card types (Companion,
+    /// Structure, Item, Map, Terrain) are refused until the engine supports them.</summary>
+    private static readonly HashSet<string> EngineTypes =
+        Enum.GetNames<CardType>().ToHashSet(StringComparer.OrdinalIgnoreCase);
+
+    public string Directory { get; } = directory;
+
+    /// <summary>All cards, ordered by id.</summary>
+    public IReadOnlyList<JsonObject> List() =>
+        Files().OrderBy(f => f.Id, StringComparer.Ordinal).Select(f => f.Card).ToList();
+
+    /// <summary>Every card file with the id written inside it — files are always found by that
+    /// id, never by file name, since a hand-edited file's name may not match.</summary>
+    private List<(string Path, string? Id, JsonObject Card)> Files() =>
+        System.IO.Directory.EnumerateFiles(Directory, "*.json")
+            .Select(file =>
+            {
+                var card = JsonNode.Parse(File.ReadAllText(file)) as JsonObject
+                    ?? throw new InvalidDataException($"Card file is not a JSON object: {file}");
+                return (file, (string?)card["id"], card);
+            })
+            .ToList();
+
+    /// <summary>Writes a card to `&lt;id&gt;.json`. <paramref name="previousId"/> is the id the card
+    /// was loaded under, or null for a new card (including a copy) — a new card may not
+    /// overwrite an existing one, and an id change moves the file.</summary>
+    public void Save(JsonObject card, string? previousId)
+    {
+        var id = (string?)card["id"] ?? throw new InvalidDataException("A card needs an \"id\".");
+        if (!IdPattern().IsMatch(id))
+            throw new InvalidDataException($"Invalid id '{id}': use letters, digits, '.', '_' or '-', starting with a letter or digit.");
+
+        var type = (string?)card["type"] ?? throw new InvalidDataException("A card needs a \"type\".");
+        if (!EngineTypes.Contains(type))
+            throw new InvalidDataException($"Card type '{type}' is not implemented yet.");
+
+        var json = card.ToJsonString(WriteOptions);
+        try
+        {
+            JsonCardDefinitionRepository.Parse(json, id);
+        }
+        catch (Exception ex) when (ex is JsonException or ArgumentException)
+        {
+            throw new InvalidDataException($"The engine can't read this card: {ex.Message}", ex);
+        }
+
+        // Ids are unique ignoring case — "Test.Grunt" and "test.grunt" would share a file on Windows.
+        var files = Files();
+        var taken = files
+            .Select(f => f.Id)
+            .FirstOrDefault(other => other is not null
+                && string.Equals(other, id, StringComparison.OrdinalIgnoreCase)
+                && !string.Equals(other, previousId, StringComparison.Ordinal));
+        if (taken is not null)
+            throw new InvalidDataException($"A card with id '{taken}' already exists.");
+
+        if (previousId is not null)
+        {
+            var oldPath = files.FirstOrDefault(f => f.Id == previousId).Path
+                ?? throw new InvalidDataException($"Card '{previousId}' no longer exists — it was deleted or renamed elsewhere.");
+            // Removed before writing: after a case-only rename both names are the same file on Windows.
+            File.Delete(oldPath);
+        }
+        File.WriteAllText(PathFor(id), json + Environment.NewLine);
+    }
+
+    public void Delete(string id)
+    {
+        var path = Files().FirstOrDefault(f => f.Id == id).Path
+            ?? throw new FileNotFoundException($"No card with id '{id}'.");
+        File.Delete(path);
+    }
+
+    private string PathFor(string id)
+    {
+        if (!IdPattern().IsMatch(id))
+            throw new InvalidDataException($"Invalid id '{id}'.");
+        return Path.Combine(Directory, id + ".json");
+    }
+
+    [GeneratedRegex("^[A-Za-z0-9][A-Za-z0-9._-]*$")]
+    private static partial Regex IdPattern();
+}
