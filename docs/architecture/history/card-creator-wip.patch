+// The card catalog lives at the repo root (content/cards), shared with tests and future tools —
+// not inside this tool's folder like scenarios/.
+var repoRoot = new DirectoryInfo(app.Environment.ContentRootPath);
+while (repoRoot is not null && !File.Exists(Path.Combine(repoRoot.FullName, "Leyline.slnx")))
+    repoRoot = repoRoot.Parent;
+var catalog = new CardCatalog(Path.Combine(
+    repoRoot?.FullName ?? throw new DirectoryNotFoundException("Repo root (Leyline.slnx) not found."),
+    "content", "cards"));
+
+app.MapGet("/api/catalog/cards", () => catalog.List());
+
+app.MapPut("/api/catalog/cards", (SaveCardRequest req) =>
+{
+    try
+    {
+        catalog.Save(req.Card, req.PreviousId);
+        return Results.Ok();
+    }
+    catch (InvalidDataException ex)
+    {
+        return Results.BadRequest(ex.Message);
+    }
+});
+
+app.MapDelete("/api/catalog/cards/{id}", (string id) =>
+{
+    try
+    {
+        catalog.Delete(id);
+        return Results.Ok();
+    }
+    catch (Exception ex) when (ex is InvalidDataException or FileNotFoundException)
+    {
+        return Results.BadRequest(ex.Message);
+    }
+});
+
